# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=recur
DB_USER=recur
DB_PASSWORD=changeme

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 chars (256-bit) for HS256
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000   # 24 hours

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
